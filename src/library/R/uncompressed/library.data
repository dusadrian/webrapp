␀function() {                          
  ctxt_pronoun <- `mask`$.env         
  if (!is.null(ctxt_pronoun)) {       
    parent.env(ctxt_pronoun) <- `old` 
  }                                   
                                      
  top <- `mask`$.top_env              
  if (is.null(top)) {                 
    top <- `mask`                     
  }                                   
                                      
  parent.env(top) <- `old`            
}                                     
