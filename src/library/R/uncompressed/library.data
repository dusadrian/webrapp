Title: Pretty Time of Day
Date: 2023-03-21
Version: 1.1.3
Authors@R: c(
    person("Kirill", "MÃ¼ller", role = c("aut", "cre"), email = "kirill@cynkra.com", comment = c(ORCID = "0000-0002-1416-3412")),
